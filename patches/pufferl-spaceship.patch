+static int space_check_actions = 0;
+__global__ void space_check_sample(Prec decoder, const float* actions, const float* executed,
+        const precision_t* logprobs, const precision_t* values) {
+    int row=blockIdx.x*blockDim.x+threadIdx.x;
+    if(row>=decoder.shape[0]) return;
+    assert(decoder.shape[1]==12);
+    assert(to_float(values[row])==to_float(decoder.data[row*12+11]));
+    float expected=0; int sizes[]={9,2},offset=0;
+    for(int head=0;head<2;++head) {
+        float raw=actions[row*2+head]; int action=(int)raw;
+        assert(raw==action && action>=0 && action<sizes[head] && raw==executed[row*2+head]);
+        float high=-INFINITY,sum=0;
+        for(int j=0;j<sizes[head];++j) high=fmaxf(high,to_float(decoder.data[row*12+offset+j]));
+        for(int j=0;j<sizes[head];++j) sum+=expf(to_float(decoder.data[row*12+offset+j])-high);
+        expected+=to_float(decoder.data[row*12+offset+action])-high-logf(sum);
+        offset+=sizes[head];
+    }
+    assert(isfinite(to_float(logprobs[row])) && fabsf(to_float(logprobs[row])-expected)<.0002f);
+}
+
