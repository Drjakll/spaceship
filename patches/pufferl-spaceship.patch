+// Spaceship reads the next value using a private copy of recurrent memory.
+__global__ void space_extract_value(const precision_t* dec, precision_t* values, int rows, int columns) {
+    int row = blockIdx.x * blockDim.x + threadIdx.x;
+    if (row < rows) values[row] = dec[row * columns + columns - 1];
+}
+static void space_prepare_bootstrap(PuffeRL* p, cudaStream_t stream) {
+    assert(PUF_BACKEND == PUF_CPU && !p->hypers.async && !p->hypers.vtrace);
+    assert(p->hypers.num_buffers == 1 && p->num_policies == 1);
+    assert(p->vec->policy_layout[0] == 0);
+    assert(p->vec->policy_layout[1] == p->hypers.total_agents);
+    int rows = p->hypers.total_agents;
+    Policy* primary = &p->policies[0];
+    int obs_n = rows * p->env.obs.shape[1];
+    cast<<<grid_size(obs_n), BLOCK_SIZE, 0, stream>>>(p->space_bootstrap_obs.data, p->env.obs.data, obs_n);
+    Prec carry = primary->buffer_states[0];
+    cudaMemcpyAsync(p->space_bootstrap_state.data, carry.data,
+        numel(carry.shape) * sizeof(precision_t), cudaMemcpyDeviceToDevice, stream);
+    zero_term_state<<<grid_size(numel(carry.shape)), BLOCK_SIZE, 0, stream>>>(
+        p->space_bootstrap_state, p->env.terminals, 0, 0, rows);
+    Prec dec = arch_forward(&primary->arch, primary->weights, primary->buf_acts[0],
+        p->space_bootstrap_obs, p->space_bootstrap_state, stream);
+    space_extract_value<<<grid_size(rows), BLOCK_SIZE, 0, stream>>>(
+        dec.data, p->space_bootstrap_values.data, rows, dec.shape[1]);
+}
+// End Spaceship bootstrap
+
+static void space_log_distribution(Dict* out, const char* prefix, Prec values) {
+    int n=numel(values.shape);
+    precision_t* data=(precision_t*)malloc(n*sizeof(precision_t)); assert(data && n>0);
+    assert(cudaMemcpy(data,values.data,n*sizeof(precision_t),cudaMemcpyDeviceToHost)==cudaSuccess);
+    double sum=0,sq=0,low=INFINITY,high=-INFINITY;
+    for(int i=0;i<n;++i) {double x=to_float(data[i]);assert(isfinite(x));sum+=x;sq+=x*x;low=fmin(low,x);high=fmax(high,x);}
+    char key[128];
+    snprintf(key,sizeof(key),"debug/%s_mean",prefix);dict_set(out,key,sum/n);
+    snprintf(key,sizeof(key),"debug/%s_std",prefix);dict_set(out,key,sqrt(fmax(0.0,sq/n-(sum/n)*(sum/n))));
+    snprintf(key,sizeof(key),"debug/%s_min",prefix);dict_set(out,key,low);
+    snprintf(key,sizeof(key),"debug/%s_max",prefix);dict_set(out,key,high);
+    free(data);
+}
+static void space_log_training(PuffeRL* p, Dict* out) {
+    double decisions=0,active=0,ticks=0,kills=0,escapes=0,damage=0,deaths=0;
+    for(int i=0;i<p->vec->size;++i) {
+        Env* e=&p->vec->envs[i];decisions+=e->world_decisions;active+=e->active_decisions;ticks+=e->physics_ticks;
+        kills+=e->kill_reward;escapes+=e->escape_reward;damage+=e->damage_reward;deaths+=e->death_reward;
+    }
+    dict_set(out,"space/world_decisions",decisions);dict_set(out,"space/active_decisions",active);
+    dict_set(out,"space/physics_ticks",ticks);
+    dict_set(out,"space/kill_reward_sum",kills);dict_set(out,"space/escape_reward_sum",escapes);
+    dict_set(out,"space/damage_reward_sum",damage);dict_set(out,"space/death_reward_sum",deaths);
+    space_log_distribution(out,"last_minibatch_advantage",p->train_buf.mb_advantages);
+    space_log_distribution(out,"last_minibatch_return",p->train_buf.mb_gae_v);
+    space_log_distribution(out,"boundary_value",p->space_bootstrap_values);
+}
+
